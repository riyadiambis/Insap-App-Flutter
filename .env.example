# ==============================================================================
# INSAP APP - PENGATURAN ENVIRONMENT (CONTOH)
# ==============================================================================
# Petunjuk:
# 1. Salin berkas ini menjadi .env:
#    cp .env.example .env
# 2. Isi nilai GEMINI_API_KEY dengan kunci API milik Anda.
# 3. Jalankan aplikasi menggunakan:
#    flutter run --dart-define-from-file=.env
#
# Catatan Build Demo Pameran (K2, ISSUE-26):
# KUOTA_PINDAI_PEKANAN hanya untuk build demo pameran (misal: 200 per pekan).
# Nilai ini dikirim melalui flag build `--dart-define=KUOTA_PINDAI_PEKANAN=200`,
# BUKAN diisi di dalam berkas .env (build biasa otomatis tetap 10 per pekan).
# ==============================================================================

# Kunci API Google Gemini (Dapatkan gratis di Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=MASUKKAN_API_KEY_GOOGLE_AI_STUDIO_DISINI

# Model Gemini yang digunakan untuk fitur Pindai Struk AI
GEMINI_MODEL=gemini-3.5-flash-lite
