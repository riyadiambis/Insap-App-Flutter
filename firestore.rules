rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pengguna/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
